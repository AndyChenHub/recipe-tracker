# Optional build-time defaults (can also be entered dynamically inside the iOS app's Import -> Configure screen)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EXPO_PUBLIC_OWNER_KEY=personal
EXPO_PUBLIC_GEMINI_API_KEY=your-optional-gemini-api-key

# Optional iOS bundle identifier override (defaults to com.chena.recipetracker)
IOS_BUNDLE_IDENTIFIER=com.chena.recipetracker
