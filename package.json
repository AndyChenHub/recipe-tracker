{
  "name": "recipe-tracker",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release:patch": "node scripts/bump-version.mjs patch --git",
    "release:minor": "node scripts/bump-version.mjs minor --git",
    "release:major": "node scripts/bump-version.mjs major --git",
    "build:ios:adhoc": "npx eas-cli build --platform ios --profile adhoc",
    "build:ios:testflight": "npx eas-cli build --platform ios --profile production --auto-submit"
  },
  "private": true
}
